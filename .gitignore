# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 外部工具：不进仓库 ----
# ffmpeg.exe / ffprobe.exe 单个就 100MB+（GitHub 单文件上限正好是 100MB），
# 而且它们各有各的许可证，不该混进本项目的版本历史。
# 首次使用请运行 tools\get-tools.bat 自动下载（脚本里的地址由各自上游维护）。
tools/*.exe
tools/N_m3u8DL-RE-*
tools/Logs/

# ---- 本机配置：现在跟程序放一起（app/core/config.py 的 Config.file）----
config.json

# ---- 打包产物 ----
build/
dist/
*.spec

# ---- 本机自检与开发辅助：文件留在本地，不进仓库 ----
# 约定同扩展仓库（MiuiX-M3U8-Extension）：仓库里只放"clone 下来就能跑"的东西。
#   tests/                          核心自检 + 假引擎
#   scripts/make_icon.py            图标生成器（图标本身在 docs/icon/）
#   docs/nm3u8dl-sample-output.txt  解析器的实测样例，自检用
tests/
scripts/
docs/nm3u8dl-sample-output.txt

# ---- 系统 / 编辑器杂物 ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~
